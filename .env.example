# ================= Supabase =================
# 在 https://supabase.com 创建免费项目后，从 Settings -> API 获取
SUPABASE_URL=https://your-project-ref.supabase.co
# Service Role Key 拥有数据库全量权限，务必只在服务端使用、绝不泄露
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ================= RSS 音频源 =================
# 公开的英语听力 RSS，例如 Simple English News Daily
RSS_FEED_URL=https://www.simpleenglishnews.com/feed/podcast

# ================= Cron 鉴权 =================
# 调用 /api/cron/update 时必须携带的密钥，请改成随机长字符串
CRON_SECRET=change-me-to-a-long-random-secret

# ================= 字幕转录（已迁移到 Cloudflare Worker） =================
# 说明：Vercel 免费函数限时 60s，转录（下载 + Whisper）必然超时，
# 因此转录改由 Cloudflare Worker 异步完成，见 cloudflare-worker/worker.js。
# Vercel 侧不再需要任何转录密钥；下面的变量是 Worker 用的（在 Worker 的
# Settings → Variables and Secrets 里配置）：
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / CRON_SECRET
#   （可选）TRANSCRIPT_CF_MODEL / TRANSCRIPT_CF_CHUNK_SECONDS /
#           TRANSCRIPT_CF_CHUNK_CONCURRENCY / TRANSCRIPT_CF_MAX_AUDIO_MB / TRANSCRIPT_MAX_ATTEMPTS
# 并在 Worker 的 Variables 中添加 "Workers AI" 绑定（变量名 AI）。

# ================= Feed 频道元信息 =================
CHANNEL_TITLE=英语听力
CHANNEL_DESCRIPTION=Aurora的英语听力

# ================= 保留策略 =================
# 数据库最多保留的节目条数（超过则删除最旧记录，Supabase 免费层仅 5000 行）
MAX_KEEP_EPISODES=30

# ================= 本地开发 =================
PORT=3000