# ================= Supabase =================
# 在 https://supabase.com 创建免费项目后，从 Settings -> API 获取
SUPABASE_URL=https://your-project-ref.supabase.co
# Service Role Key 拥有数据库全量权限，务必只在服务端使用、绝不泄露
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ================= RSS 音频源 =================
# 公开的英语听力 RSS，例如 Simple English News Daily
RSS_FEED_URL=https://www.simpleenglishnews.com/feed/podcast

# ================= Cron 鉴权 =================
# 调用 /api/cron/update 时必须携带的密钥，请改成随机长字符串
CRON_SECRET=change-me-to-a-long-random-secret

# ================= 字幕生成 =================
# cf-whisper -> 使用 Cloudflare Workers AI Whisper 转录字幕（免费额度内不产生费用，推荐）。
#               Whisper 会生成带时间戳的 VTT 字幕，手表端可像歌词一样逐行实时显示。
# groq       -> 使用 Groq Whisper 转录（需要 TRANSCRIPT_API_KEY）
# none       -> 不调用转录 API（无实时字幕；条目会保持 pending，配置好后 cron 自动补录）
# 注意：RSS 自带的 description 只是节目简介，不是实时字幕，不会再被当作字幕使用。
TRANSCRIPT_API_TYPE=cf-whisper

# --- Cloudflare Workers AI（TRANSCRIPT_API_TYPE=cf-whisper 时需要）---
# 免费额度：Free 计划每天 10,000 neurons。只要不绑定支付方式，就绝不会产生任何费用；
# 额度用尽后接口返回 429，本服务会自动回退 RSS 描述，次日额度恢复后 cron 自动重试。
# 1) Account ID：Cloudflare 控制台右侧栏 "Account ID"
# 2) API Token：控制台 -> 右上角头像 -> My Profile -> API Tokens -> Create Token，
#    模板选 "Workers AI: Run"（权限：Account > Workers AI > Run），账号范围选当前账号
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 可选：指定 Whisper 模型（默认稳定版 @cf/openai/whisper；
# 也可试更快的 @cf/onnx-community/whisper-large-v3-turbo，属于 Beta）
TRANSCRIPT_CF_MODEL=@cf/openai/whisper
# 可选：转录最多重试次数（超过则标记 failed，不再重复消耗额度/时间）
TRANSCRIPT_MAX_ATTEMPTS=3

# --- Groq（仅 TRANSCRIPT_API_TYPE=groq 时需要）---
# Groq 控制台 https://console.groq.com/keys 申请的 API Key
TRANSCRIPT_API_KEY=

# ================= Feed 频道元信息 =================
CHANNEL_TITLE=英语听力
CHANNEL_DESCRIPTION=Aurora的英语听力

# ================= 保留策略 =================
# 数据库最多保留的节目条数（超过则删除最旧记录，Supabase 免费层仅 5000 行）
MAX_KEEP_EPISODES=30

# ================= 本地开发 =================
PORT=3000