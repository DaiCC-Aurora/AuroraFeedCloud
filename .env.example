# ================= Supabase =================
# 在 https://supabase.com 创建免费项目后，从 Settings -> API 获取
SUPABASE_URL=https://your-project-ref.supabase.co
# Service Role Key 拥有数据库全量权限，务必只在服务端使用、绝不泄露
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ================= RSS 音频源 =================
# 公开的英语听力 RSS，例如 Simple English News Daily
RSS_FEED_URL=https://www.simpleenglishnews.com/feed/podcast

# ================= Cron 鉴权 =================
# 调用 /api/cron/update 时必须携带的密钥，请改成随机长字符串
CRON_SECRET=change-me-to-a-long-random-secret

# ================= 字幕生成 =================
# groq   -> 使用 Groq Whisper 转录（需要 TRANSCRIPT_API_KEY）
# none   -> 不调用转录 API，直接使用 RSS 自带的 description 作为字幕（最省、最稳）
TRANSCRIPT_API_TYPE=groq
# Groq 控制台 https://console.groq.com/keys 申请的 API Key（TRANSCRIPT_API_TYPE=none 时可留空）
TRANSCRIPT_API_KEY=

# ================= Feed 频道元信息 =================
CHANNEL_TITLE=英语听力
CHANNEL_DESCRIPTION=Aurora的英语听力

# ================= 保留策略 =================
# 数据库最多保留的节目条数（超过则删除最旧记录，Supabase 免费层仅 5000 行）
MAX_KEEP_EPISODES=30

# ================= 本地开发 =================
PORT=3000